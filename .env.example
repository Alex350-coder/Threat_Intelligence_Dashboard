# Copy this file to .env and fill in real values. Never commit .env.

# Provider API keys
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=
URLSCAN_API_KEY=

# Cache
CACHE_TTL=

# History (max recent search records kept, optional — defaults to 100)
HISTORY_LIMIT=

# Database (SQLite file path, optional — defaults to ./data/threat-intel.db)
DB_PATH=

# Rate limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# CORS
CORS_ORIGIN=

# Server
PORT=
