# Copy this file to .env and fill in real values. Never commit .env.

# Provider API keys
VIRUSTOTAL_API_KEY=DefinitelyNotARealVirusTotalKey
ABUSEIPDB_API_KEY=ThisKeyProtectsAbsolutelyNothing
# IPInfo/URLScan are documented in ApiProviders.md as future providers (see Roadmap.md) but are
# not yet wired into the provider registry — safe to leave blank for the current MVP.
IPINFO_TOKEN=NiceTryButStillFake
URLSCAN_API_KEY=StopLookingHereAndGetYourOwnKey

# Cache
CACHE_TTL=

# History (max recent search records kept, optional — defaults to 100)
HISTORY_LIMIT=

# Database (SQLite file path, optional — defaults to ./data/threat-intel.db)
DB_PATH=

# Rate limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# CORS
CORS_ORIGIN=

# Server
PORT=
# Number of reverse-proxy hops in front of the app (e.g. 1 for a single PaaS load balancer/CDN
# edge). Controls how many X-Forwarded-* hops Express trusts for the real client IP (used by
# rate limiting) and protocol (used to decide whether to send Strict-Transport-Security). Leave
# unset (0) for local dev with no proxy — setting this to "true" or an unbounded value would let
# a client spoof its IP and bypass rate limiting.
TRUST_PROXY_HOPS=

# Frontend (optional — defaults to http://localhost:4000 in dev)
VITE_API_BASE_URL=
